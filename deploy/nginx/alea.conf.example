# Plantilla para el Nginx instalado en el host.
#
# Antes de habilitarla, sustituir TODOS los tokens siguientes:
#   __FRONTEND_PATH__       Ruta sin slash final, por ejemplo /alea
#   __BACKEND_PATH__        Ruta distinta, sin slash final, por ejemplo /alea-api
#   __TLS_CERTIFICATE__     Ruta absoluta al certificado publico
#   __TLS_CERTIFICATE_KEY__ Ruta absoluta a la llave privada
#
# No agregue una URI ni un slash final a las directivas proxy_pass. Al no tener
# URI, Nginx conserva la ruta publica completa al enviarla a cada upstream.

server {
    listen 80;
    listen [::]:80;
    server_name alea.sesna.gob.mx;

    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name alea.sesna.gob.mx;
    server_tokens off;

    ssl_certificate __TLS_CERTIFICATE__;
    ssl_certificate_key __TLS_CERTIFICATE_KEY__;

    # Evita dos URLs equivalentes y garantiza una base terminada en slash.
    location = __FRONTEND_PATH__ {
        return 308 __FRONTEND_PATH__/$is_args$args;
    }

    location ^~ __FRONTEND_PATH__/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Este Nginx es el primer proxy publico: no se hereda un XFF enviado
        # directamente por el cliente.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Prefix __FRONTEND_PATH__;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location = __BACKEND_PATH__ {
        return 308 __BACKEND_PATH__/$is_args$args;
    }

    location ^~ __BACKEND_PATH__/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Prefix __BACKEND_PATH__;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # No expone la pagina predeterminada del Nginx del host en otras rutas.
    location / {
        return 404;
    }
}

# Acceso directo al backend local. Nest expone todos sus endpoints bajo /api.
# En el contenedor web productivo prevalece API_BASE_URL de runtime-config.js.
VITE_API_URL=http://localhost:3001/api

# Proxy opcional de Vite: cambia VITE_API_URL a /api y descomenta el target.
# El proxy conserva /api al reenviar la solicitud al backend.
# VITE_PROXY_TARGET=http://localhost:3001
